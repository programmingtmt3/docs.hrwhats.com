# بيانات دخول لوحة التحكم (غيّرها قبل النشر)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# مفتاح توقيع الجلسة: نص عشوائي طويل (32 حرفًا أو أكثر)
# للتوليد: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string

# اختياري: مسار تخزين ملف المحتوى (الافتراضي ./data)
# DATA_DIR=./data
