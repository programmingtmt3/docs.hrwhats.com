# بيانات دخول لوحة التحكم (غيّرها قبل النشر)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# مفتاح توقيع الجلسة: نص عشوائي طويل (32 حرفًا أو أكثر)
# للتوليد: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string

# قاعدة بيانات MySQL: mysql://المستخدم:كلمة_المرور@الخادم:المنفذ/اسم_القاعدة
DATABASE_URL=mysql://root:password@localhost:3306/hrwhats

# اختياري: مسار حفظ الصور المرفوعة (الافتراضي ./data → ./data/uploads)
# DATA_DIR=./data
